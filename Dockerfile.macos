FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    clang \
    cmake \
    libssl-dev \
    lzma-dev \
    libxml2-dev \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Add MacOS targets
RUN rustup target add x86_64-apple-darwin aarch64-apple-darwin

# Install osxcross for MacOS cross-compilation
WORKDIR /opt
RUN git clone https://github.com/tpoechtrager/osxcross.git
WORKDIR /opt/osxcross

# Download MacOS SDK (using a publicly available one)
RUN curl -L -o tarballs/MacOSX12.3.sdk.tar.xz \
    https://github.com/joseluisq/macosx-sdks/releases/download/12.3/MacOSX12.3.sdk.tar.xz

# Build osxcross
RUN UNATTENDED=yes OSX_VERSION_MIN=10.9 ./build.sh

# Set up environment and cargo config
ENV PATH="/opt/osxcross/target/bin:${PATH}"
RUN mkdir -p /root/.cargo
RUN echo '[target.x86_64-apple-darwin]' > /root/.cargo/config.toml && \
    echo 'linker = "x86_64-apple-darwin21.4-clang"' >> /root/.cargo/config.toml && \
    echo '[target.aarch64-apple-darwin]' >> /root/.cargo/config.toml && \
    echo 'linker = "aarch64-apple-darwin21.4-clang"' >> /root/.cargo/config.toml

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src

# Build for both architectures
RUN cargo build --target x86_64-apple-darwin --release
RUN cargo build --target aarch64-apple-darwin --release

# Create universal binary
RUN x86_64-apple-darwin21.4-lipo -create \
    target/x86_64-apple-darwin/release/subculture-save-editor \
    target/aarch64-apple-darwin/release/subculture-save-editor \
    -output subculture-save-editor-macos

CMD ["cp", "/app/subculture-save-editor-macos", "/output/"]